# Public Firebase web-app config (safe to expose in the browser).
# Vite inlines these at BUILD time. On Vercel they must exist as Environment
# Variables for Production/Preview and you must Redeploy after adding them.
# Copy to .env for local development. Never commit .env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
